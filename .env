# Single source of truth for the dev proxy target, shared by all three Vite
# apps (frontend, frontend/storepanel, frontend/storepub).
#
# Read at dev-server startup by shared/viteProxy.mjs. Changing the backend port
# means editing this one line — not three vite.config.js files.
#
# This file is committed on purpose so a fresh clone works without setup, so
# keep it to non-secret dev values. Real secrets stay in backend/.env.local.
BACKEND_URL=http://localhost:3000